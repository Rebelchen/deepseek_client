# 环境变量清单模板。仅作说明用：代码不会读取本文件，也不会读取 .env。
#
# 密钥请配置成环境变量，推荐一键写入虚拟环境激活脚本（激活即生效）：
#   powershell -ExecutionPolicy Bypass -File scripts\setup_venv_keys.ps1
#
# 支持的来源、端点与模型清单见 config.py 的 SOURCES（或 docs/API.md）。

SOURCE=opencode_go
DEEPSEEK_API_KEY=
OPENCODE_GO_API_KEY=
ZBIGMODEL_API_KEY=
BAILIAN_TOKEN_PLAN_API_KEY=
STEPFUN_API_KEY=
XIAOMI_MIMO_API_KEY=
